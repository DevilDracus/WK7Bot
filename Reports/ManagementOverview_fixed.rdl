<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition">
  <Description>Management Overview dashboard based on report.vw_CaseDashboard</Description>
  <Author>Hermes</Author>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="CaseDataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=CaseManagement;Integrated Security=True</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>11111111-2222-3333-4444-555555555555</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="CaseDashboard">
      <Query>
        <DataSourceName>CaseDataSource</DataSourceName>
        <CommandText>SELECT * FROM [report].[vw_CaseDashboard]</CommandText>
      </Query>
      <Fields>
        <Field Name="court_proceedings_total"><DataField>court_proceedings_total</DataField></Field>
        <Field Name="open_court_proceedings"><DataField>open_court_proceedings</DataField></Field>
        <Field Name="proceedings_open_ordinary"><DataField>proceedings_open_ordinary</DataField></Field>
        <Field Name="proceedings_open_verbal"><DataField>proceedings_open_verbal</DataField></Field>
        <Field Name="proceedings_open_by_instance_first_pending_created"><DataField>proceedings_open_by_instance_first_pending_created</DataField></Field>
        <Field Name="proceedings_open_by_instance_second_pending_created"><DataField>proceedings_open_by_instance_second_pending_created</DataField></Field>
        <Field Name="instance_amount_in_dispute"><DataField>instance_amount_in_dispute</DataField></Field>
        <Field Name="policy_surrender_value"><DataField>policy_surrender_value</DataField></Field>
        <Field Name="proceedings_dispute_amount_missing"><DataField>proceedings_dispute_amount_missing</DataField></Field>
        <Field Name="deadlines_open_next_week"><DataField>deadlines_open_next_week</DataField></Field>
        <Field Name="deadlines_open_next_month"><DataField>deadlines_open_next_month</DataField></Field>
        <Field Name="appointments_open_next_week"><DataField>appointments_open_next_week</DataField></Field>
        <Field Name="appointments_open_next_month"><DataField>appointments_open_next_month</DataField></Field>
        <Field Name="decision_by_court"><DataField>decision_by_court</DataField></Field>
        <Field Name="ProceedingsWithFullyUpheldClaim"><DataField>ProceedingsWithFullyUpheldClaim</DataField></Field>
        <Field Name="ProceedingsWithPartiallyUpheldClaim"><DataField>ProceedingsWithPartiallyUpheldClaim</DataField></Field>
        <Field Name="ProceedingsWithDismissedClaim"><DataField>ProceedingsWithDismissedClaim</DataField></Field>
        <Field Name="court_proceedings_billed_closed"><DataField>court_proceedings_billed_closed</DataField></Field>
        <Field Name="court_proceedings_settlement_completed"><DataField>court_proceedings_settlement_completed</DataField></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="CaseStatus">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <Prompt>Case Status</Prompt>
    </ReportParameter>
    <ReportParameter Name="Instance">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <Prompt>Instance</Prompt>
    </ReportParameter>
    <ReportParameter Name="ProceedingType">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <Prompt>Proceeding Type</Prompt>
    </ReportParameter>
    <ReportParameter Name="Court">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <Prompt>Court</Prompt>
    </ReportParameter>
    <ReportParameter Name="AppealStatus">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <Prompt>Appeal Status</Prompt>
    </ReportParameter>
    <ReportParameter Name="FinalityStatus">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <Prompt>Finality Status</Prompt>
    </ReportParameter>
    <ReportParameter Name="SettlementStatus">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <Prompt>Settlement Status</Prompt>
    </ReportParameter>
    <ReportParameter Name="DateFrom">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <Prompt>Date From</Prompt>
    </ReportParameter>
    <ReportParameter Name="DateTo">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <Prompt>Date To</Prompt>
    </ReportParameter>
    <ReportParameter Name="AmountMin">
      <DataType>Float</DataType>
      <Nullable>true</Nullable>
      <Prompt>Amount Min</Prompt>
    </ReportParameter>
    <ReportParameter Name="AmountMax">
      <DataType>Float</DataType>
      <Nullable>true</Nullable>
      <Prompt>Amount Max</Prompt>
    </ReportParameter>
  </ReportParameters>
  <ReportSections>
    <ReportSection>
      <Body>
    <ReportItems>
      <!-- KPI cards top row -->
      <Textbox Name="KpiTotalProceedingsLabel">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun><Value>Total proceedings</Value><Style><FontSize>10pt</FontSize><Color>#555555</Color></Style></TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>KpiTotalProceedingsLabel</rd:DefaultName>
        <Top>0in</Top><Left>0in</Left><Height>0.3in</Height><Width>2.4in</Width>
        <Style><Border><Style>None</Style></Border><PaddingLeft>4pt</PaddingLeft></Style>
      </Textbox>
      <Textbox Name="KpiTotalProceedingsValue">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun><Value>=Fields!court_proceedings_total.Value</Value><Style><FontSize>24pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F3864</Color></Style></TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>KpiTotalProceedingsValue</rd:DefaultName>
        <Top>0.3in</Top><Left>0in</Left><Height>0.6in</Height><Width>2.4in</Width>
        <Style><Border><Style>Solid</Style><Width>1pt</Width><Color>#DDDDDD</Color></Border><PaddingLeft>4pt</PaddingLeft></Style>
      </Textbox>

      <Textbox Name="KpiOpenProceedingsLabel">
        <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>Open proceedings</Value><Style><FontSize>10pt</FontSize><Color>#555555</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
        <Top>0in</Top><Left>2.5in</Left><Height>0.3in</Height><Width>2.4in</Width>
        <Style><Border><Style>None</Style></Border><PaddingLeft>4pt</PaddingLeft></Style>
      </Textbox>
      <Textbox Name="KpiOpenProceedingsValue">
        <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!open_court_proceedings.Value</Value><Style><FontSize>24pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F3864</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
        <Top>0.3in</Top><Left>2.5in</Left><Height>0.6in</Height><Width>2.4in</Width>
        <Style><Border><Style>Solid</Style><Width>1pt</Width><Color>#DDDDDD</Color></Border><PaddingLeft>4pt</PaddingLeft></Style>
      </Textbox>

      <Textbox Name="KpiConcludedProceedingsLabel">
        <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>Concluded proceedings</Value><Style><FontSize>10pt</FontSize><Color>#555555</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
        <Top>0in</Top><Left>5in</Left><Height>0.3in</Height><Width>2.4in</Width>
        <Style><Border><Style>None</Style></Border><PaddingLeft>4pt</PaddingLeft></Style>
      </Textbox>
      <Textbox Name="KpiConcludedProceedingsValue">
        <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!court_proceedings_billed_closed.Value</Value><Style><FontSize>24pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F3864</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
        <Top>0.3in</Top><Left>5in</Left><Height>0.6in</Height><Width>2.4in</Width>
        <Style><Border><Style>Solid</Style><Width>1pt</Width><Color>#DDDDDD</Color></Border><PaddingLeft>4pt</PaddingLeft></Style>
      </Textbox>

      <Textbox Name="KpiConcludedSettlementsLabel">
        <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>Concluded settlements</Value><Style><FontSize>10pt</FontSize><Color>#555555</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
        <Top>0in</Top><Left>7.5in</Left><Height>0.3in</Height><Width>2.4in</Width>
        <Style><Border><Style>None</Style></Border><PaddingLeft>4pt</PaddingLeft></Style>
      </Textbox>
      <Textbox Name="KpiConcludedSettlementsValue">
        <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!court_proceedings_settlement_completed.Value</Value><Style><FontSize>24pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F3864</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
        <Top>0.3in</Top><Left>7.5in</Left><Height>0.6in</Height><Width>2.4in</Width>
        <Style><Border><Style>Solid</Style><Width>1pt</Width><Color>#DDDDDD</Color></Border><PaddingLeft>4pt</PaddingLeft></Style>
      </Textbox>

      <!-- Horizontal bar chart: Open cases by highest instance -->
      <Chart Name="ChartOpenByInstance">
        <ChartTitles><ChartTitle Name="Title1"><Caption>Open cases by highest instance</Caption></ChartTitle></ChartTitles>
        <ChartAreas>
          <ChartArea Name="Default">
            <ChartCategoryAxes>
              <ChartAxis Name="Primary">
                <Style><FontSize>9pt</FontSize></Style>
                <ChartAxisTitle><Caption>Instance</Caption></ChartAxisTitle>
              </ChartAxis>
            </ChartCategoryAxes>
            <ChartValueAxes>
              <ChartAxis Name="Primary">
                <Style><FontSize>9pt</FontSize></Style>
              </ChartAxis>
            </ChartValueAxes>
          </ChartArea>
        </ChartAreas>
        <ChartLegends>
          <ChartLegend Name="Default"><Style><FontSize>9pt</FontSize></Style></ChartLegend>
        </ChartLegends>
        <ChartCategoryHierarchy>
          <ChartMembers><ChartMember><Label /></ChartMember></ChartMembers>
        </ChartCategoryHierarchy>
        <ChartSeriesHierarchy>
          <ChartMembers><ChartMember><Label /></ChartMember></ChartMembers>
        </ChartSeriesHierarchy>
        <ChartData>
          <ChartSeriesCollection>
            <ChartSeries Name="OpenCases">
              <Type>Bar</Type>
              <Style><BackgroundColor>#4472C4</BackgroundColor></Style>
              <ChartDataPoints>
                <ChartDataPoint>
                  <ChartDataPointValues><Y>=Fields!proceedings_open_by_instance_first_pending_created.Value</Y></ChartDataPointValues>
                  <AxisLabel>First instance</AxisLabel>
                </ChartDataPoint>
                <ChartDataPoint>
                  <ChartDataPointValues><Y>=Fields!proceedings_open_by_instance_second_pending_created.Value</Y></ChartDataPointValues>
                  <AxisLabel>Second instance</AxisLabel>
                </ChartDataPoint>
              </ChartDataPoints>
            </ChartSeries>
          </ChartSeriesCollection>
        </ChartData>
        <Top>1.1in</Top><Left>0in</Left><Height>2.6in</Height><Width>4.9in</Width>
      </Chart>

      <!-- Horizontal bar chart: Open cases by proceeding type -->
      <Chart Name="ChartOpenByProceedingType">
        <ChartTitles><ChartTitle Name="Title1"><Caption>Open cases by proceeding type</Caption></ChartTitle></ChartTitles>
        <ChartAreas>
          <ChartArea Name="Default">
            <ChartCategoryAxes>
              <ChartAxis Name="Primary"><Style><FontSize>9pt</FontSize></Style></ChartAxis>
            </ChartCategoryAxes>
            <ChartValueAxes>
              <ChartAxis Name="Primary"><Style><FontSize>9pt</FontSize></Style></ChartAxis>
            </ChartValueAxes>
          </ChartArea>
        </ChartAreas>
        <ChartCategoryHierarchy>
          <ChartMembers><ChartMember><Label /></ChartMember></ChartMembers>
        </ChartCategoryHierarchy>
        <ChartSeriesHierarchy>
          <ChartMembers><ChartMember><Label /></ChartMember></ChartMembers>
        </ChartSeriesHierarchy>
        <ChartData>
          <ChartSeriesCollection>
            <ChartSeries Name="OpenCases">
              <Type>Bar</Type>
              <Style><BackgroundColor>#70AD47</BackgroundColor></Style>
              <ChartDataPoints>
                <ChartDataPoint>
                  <ChartDataPointValues><Y>=Fields!proceedings_open_ordinary.Value</Y></ChartDataPointValues>
                  <AxisLabel>Ordinario</AxisLabel>
                </ChartDataPoint>
                <ChartDataPoint>
                  <ChartDataPointValues><Y>=Fields!proceedings_open_verbal.Value</Y></ChartDataPointValues>
                  <AxisLabel>Verbal</AxisLabel>
                </ChartDataPoint>
              </ChartDataPoints>
            </ChartSeries>
          </ChartSeriesCollection>
        </ChartData>
        <Top>1.1in</Top><Left>5.1in</Left><Height>2.6in</Height><Width>4.9in</Width>
      </Chart>

      <!-- Grouped column chart: Upcoming deadlines and hearings -->
      <Chart Name="ChartUpcoming">
        <ChartTitles><ChartTitle Name="Title1"><Caption>Upcoming deadlines and hearings</Caption></ChartTitle></ChartTitles>
        <ChartAreas>
          <ChartArea Name="Default">
            <ChartCategoryAxes>
              <ChartAxis Name="Primary"><Style><FontSize>9pt</FontSize></Style></ChartAxis>
            </ChartCategoryAxes>
            <ChartValueAxes>
              <ChartAxis Name="Primary"><Style><FontSize>9pt</FontSize></Style></ChartAxis>
            </ChartValueAxes>
          </ChartArea>
        </ChartAreas>
        <ChartLegends>
          <ChartLegend Name="Default"><Style><FontSize>9pt</FontSize></Style></ChartLegend>
        </ChartLegends>
        <ChartCategoryHierarchy>
          <ChartMembers><ChartMember><Label /></ChartMember></ChartMembers>
        </ChartCategoryHierarchy>
        <ChartSeriesHierarchy>
          <ChartMembers><ChartMember><Label /></ChartMember></ChartMembers>
        </ChartSeriesHierarchy>
        <ChartData>
          <ChartSeriesCollection>
            <ChartSeries Name="Deadlines">
              <Type>Column</Type>
              <Style><BackgroundColor>#4472C4</BackgroundColor></Style>
              <ChartDataPoints>
                <ChartDataPoint>
                  <ChartDataPointValues><Y>=Fields!deadlines_open_next_week.Value</Y></ChartDataPointValues>
                  <AxisLabel>Next 7 days</AxisLabel>
                </ChartDataPoint>
                <ChartDataPoint>
                  <ChartDataPointValues><Y>=Fields!deadlines_open_next_month.Value</Y></ChartDataPointValues>
                  <AxisLabel>Next 30 days</AxisLabel>
                </ChartDataPoint>
              </ChartDataPoints>
            </ChartSeries>
            <ChartSeries Name="Hearings">
              <Type>Column</Type>
              <Style><BackgroundColor>#70AD47</BackgroundColor></Style>
              <ChartDataPoints>
                <ChartDataPoint>
                  <ChartDataPointValues><Y>=Fields!appointments_open_next_week.Value</Y></ChartDataPointValues>
                  <AxisLabel>Next 7 days</AxisLabel>
                </ChartDataPoint>
                <ChartDataPoint>
                  <ChartDataPointValues><Y>=Fields!appointments_open_next_month.Value</Y></ChartDataPointValues>
                  <AxisLabel>Next 30 days</AxisLabel>
                </ChartDataPoint>
              </ChartDataPoints>
            </ChartSeries>
          </ChartSeriesCollection>
        </ChartData>
        <Top>3.9in</Top><Left>0in</Left><Height>2.6in</Height><Width>10in</Width>
      </Chart>

      <!-- Two KPI cards: Aggregate claimed amount, Aggregate policy surrender value -->
      <Textbox Name="KpiClaimedAmountLabel">
        <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>Aggregate claimed amount</Value><Style><FontSize>10pt</FontSize><Color>#555555</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
        <Top>6.7in</Top><Left>0in</Left><Height>0.3in</Height><Width>4.9in</Width>
        <Style><Border><Style>None</Style></Border><PaddingLeft>4pt</PaddingLeft></Style>
      </Textbox>
      <Textbox Name="KpiClaimedAmountValue">
        <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!instance_amount_in_dispute.Value</Value><Style><FontSize>20pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F3864</Color><Format>C2</Format></Style></TextRun></TextRuns></Paragraph></Paragraphs>
        <Top>7.0in</Top><Left>0in</Left><Height>0.6in</Height><Width>4.9in</Width>
        <Style><Border><Style>Solid</Style><Width>1pt</Width><Color>#DDDDDD</Color></Border><PaddingLeft>4pt</PaddingLeft></Style>
      </Textbox>
      <Textbox Name="KpiSurrenderValueLabel">
        <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>Aggregate policy surrender value</Value><Style><FontSize>10pt</FontSize><Color>#555555</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
        <Top>6.7in</Top><Left>5.1in</Left><Height>0.3in</Height><Width>4.9in</Width>
        <Style><Border><Style>None</Style></Border><PaddingLeft>4pt</PaddingLeft></Style>
      </Textbox>
      <Textbox Name="KpiSurrenderValueValue">
        <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!policy_surrender_value.Value</Value><Style><FontSize>20pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F3864</Color><Format>C2</Format></Style></TextRun></TextRuns></Paragraph></Paragraphs>
        <Top>7.0in</Top><Left>5.1in</Left><Height>0.6in</Height><Width>4.9in</Width>
        <Style><Border><Style>Solid</Style><Width>1pt</Width><Color>#DDDDDD</Color></Border><PaddingLeft>4pt</PaddingLeft></Style>
      </Textbox>

      <!-- Horizontal bars: Judgment outcomes -->
      <Chart Name="ChartJudgmentOutcomes">
        <ChartTitles><ChartTitle Name="Title1"><Caption>Judgment outcomes</Caption></ChartTitle></ChartTitles>
        <ChartAreas>
          <ChartArea Name="Default">
            <ChartCategoryAxes>
              <ChartAxis Name="Primary"><Style><FontSize>9pt</FontSize></Style></ChartAxis>
            </ChartCategoryAxes>
            <ChartValueAxes>
              <ChartAxis Name="Primary"><Style><FontSize>9pt</FontSize></Style></ChartAxis>
            </ChartValueAxes>
          </ChartArea>
        </ChartAreas>
        <ChartCategoryHierarchy>
          <ChartMembers><ChartMember><Label /></ChartMember></ChartMembers>
        </ChartCategoryHierarchy>
        <ChartSeriesHierarchy>
          <ChartMembers><ChartMember><Label /></ChartMember></ChartMembers>
        </ChartSeriesHierarchy>
        <ChartData>
          <ChartSeriesCollection>
            <ChartSeries Name="Outcomes">
              <Type>Bar</Type>
              <Style><BackgroundColor>#4472C4</BackgroundColor></Style>
              <ChartDataPoints>
                <ChartDataPoint>
                  <ChartDataPointValues><Y>=Fields!ProceedingsWithFullyUpheldClaim.Value</Y></ChartDataPointValues>
                  <AxisLabel>Fully upheld</AxisLabel>
                </ChartDataPoint>
                <ChartDataPoint>
                  <ChartDataPointValues><Y>=Fields!ProceedingsWithPartiallyUpheldClaim.Value</Y></ChartDataPointValues>
                  <AxisLabel>Partially upheld</AxisLabel>
                </ChartDataPoint>
                <ChartDataPoint>
                  <ChartDataPointValues><Y>=Fields!ProceedingsWithDismissedClaim.Value</Y></ChartDataPointValues>
                  <AxisLabel>Dismissed</AxisLabel>
                </ChartDataPoint>
              </ChartDataPoints>
            </ChartSeries>
          </ChartSeriesCollection>
        </ChartData>
        <Top>7.8in</Top><Left>0in</Left><Height>2.4in</Height><Width>4.9in</Width>
      </Chart>
      <Textbox Name="JudgmentPercentages">
        <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph><TextRuns><TextRun><Value>="Fully upheld: " &amp; FormatPercent(IIF(Fields!decision_by_court.Value=0,0,Fields!ProceedingsWithFullyUpheldClaim.Value/Fields!decision_by_court.Value)) &amp; " | Partially upheld: " &amp; FormatPercent(IIF(Fields!decision_by_court.Value=0,0,Fields!ProceedingsWithPartiallyUpheldClaim.Value/Fields!decision_by_court.Value)) &amp; " | Dismissed: " &amp; FormatPercent(IIF(Fields!decision_by_court.Value=0,0,Fields!ProceedingsWithDismissedClaim.Value/Fields!decision_by_court.Value))</Value><Style><FontSize>9pt</FontSize></Style></TextRun></TextRuns></Paragraph>
        </Paragraphs>
        <Top>10.2in</Top><Left>0in</Left><Height>0.3in</Height><Width>4.9in</Width>
        <Style><Border><Style>None</Style></Border></Style>
      </Textbox>

      <!-- KPI card + proportion bar: Concluded cases and settlements -->
      <Textbox Name="KpiConcludedSettlementsCardLabel">
        <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>Concluded cases and settlements</Value><Style><FontSize>10pt</FontSize><Color>#555555</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
        <Top>7.8in</Top><Left>5.1in</Left><Height>0.3in</Height><Width>4.9in</Width>
        <Style><Border><Style>None</Style></Border><PaddingLeft>4pt</PaddingLeft></Style>
      </Textbox>
      <Textbox Name="KpiConcludedSettlementsCardValue">
        <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!court_proceedings_billed_closed.Value &amp; " concluded / " &amp; Fields!court_proceedings_settlement_completed.Value &amp; " settlements"</Value><Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F3864</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
        <Top>8.1in</Top><Left>5.1in</Left><Height>0.6in</Height><Width>4.9in</Width>
        <Style><Border><Style>Solid</Style><Width>1pt</Width><Color>#DDDDDD</Color></Border><PaddingLeft>4pt</PaddingLeft></Style>
      </Textbox>
      <Chart Name="ChartProportion">
        <ChartTitles><ChartTitle Name="Title1"><Caption>Settlements as proportion of concluded</Caption></ChartTitle></ChartTitles>
        <ChartAreas>
          <ChartArea Name="Default">
            <ChartCategoryAxes>
              <ChartAxis Name="Primary"><Style><FontSize>9pt</FontSize></Style></ChartAxis>
            </ChartCategoryAxes>
            <ChartValueAxes>
              <ChartAxis Name="Primary"><Style><FontSize>9pt</FontSize></Style><Maximum>100</Maximum></ChartAxis>
            </ChartValueAxes>
          </ChartArea>
        </ChartAreas>
        <ChartCategoryHierarchy>
          <ChartMembers><ChartMember><Label /></ChartMember></ChartMembers>
        </ChartCategoryHierarchy>
        <ChartSeriesHierarchy>
          <ChartMembers><ChartMember><Label /></ChartMember></ChartMembers>
        </ChartSeriesHierarchy>
        <ChartData>
          <ChartSeriesCollection>
            <ChartSeries Name="Proportion">
              <Type>Bar</Type>
              <Style><BackgroundColor>#C55A11</BackgroundColor></Style>
              <ChartDataPoints>
                <ChartDataPoint>
                  <ChartDataPointValues><Y>=IIF(Fields!court_proceedings_billed_closed.Value=0,0,Fields!court_proceedings_settlement_completed.Value/Fields!court_proceedings_billed_closed.Value*100)</Y></ChartDataPointValues>
                  <AxisLabel>Settlements %</AxisLabel>
                </ChartDataPoint>
              </ChartDataPoints>
            </ChartSeries>
          </ChartSeriesCollection>
        </ChartData>
        <Top>8.8in</Top><Left>5.1in</Left><Height>1.8in</Height><Width>4.9in</Width>
      </Chart>
    </ReportItems>
    <Height>10.6in</Height>
    <Style />
  </Body>
  <Width>10in</Width>
  <Page>
    <PageWidth>11in</PageWidth>
    <PageHeight>8.5in</PageHeight>
    <LeftMargin>0.5in</LeftMargin>
    <RightMargin>0.5in</RightMargin>
    <TopMargin>0.5in</TopMargin>
    <BottomMargin>0.5in</BottomMargin>
  </Page>
    </ReportSection>
  </ReportSections>
  <Language>en-US</Language>
  <ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
</Report>