<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <UserSecretsId>8c7b6003-f1eb-4482-b254-5ac26a348c0c</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="WK7Bot.Tests" />
    </ItemGroup>

    <!-- The Home Assistant add-on version in config.yaml is the single source of truth for the
         version the bot reports (/health and the MQTT device attributes). Reading it at evaluation
         time keeps the assembly version in sync with the add-on image tag on every build, instead
         of defaulting to 1.0.0. -->
    <PropertyGroup>
        <AddOnConfigYaml>$(MSBuildProjectDirectory)\config.yaml</AddOnConfigYaml>
        <AddOnVersion Condition="Exists('$(AddOnConfigYaml)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(AddOnConfigYaml)')), '(?m)^version:\s*"?([^"\s]+)"?').Groups[1].Value)</AddOnVersion>
        <Version Condition="'$(AddOnVersion)' != ''">$(AddOnVersion)</Version>
        <AssemblyVersion Condition="'$(AddOnVersion)' != ''">$(AddOnVersion).0</AssemblyVersion>
        <FileVersion Condition="'$(AddOnVersion)' != ''">$(AddOnVersion).0</FileVersion>
        <InformationalVersion Condition="'$(AddOnVersion)' != ''">$(AddOnVersion)</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CodeHollow.FeedReader" Version="1.2.6" />
        <PackageReference Include="Discord.Net" Version="3.17.1" />
        <PackageReference Include="Ical.Net" Version="5.2.3" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    </ItemGroup>

</Project>